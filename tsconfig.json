{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": [
      "vite/client",
      "vite-plugin-pwa/react"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "components",
    "hooks",
    "utils",
    "services"
  ],
  "exclude": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/sw.ts"
  ]
}
